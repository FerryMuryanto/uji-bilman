                                >
                                  Ubah Angka
                                </button>
                              )}
                            </td>
                          </tr>
                        );
                      })}

                      <tr className="bg-[#f97316] text-black font-black text-xs">
                        <td colSpan={3} className="border-2 border-black p-2 text-center uppercase">
                          TOTAL {activeUlpMeta.nama} — {feat.namaFitur.toUpperCase()}
                        </td>
                        <td className="border-2 border-black p-2 text-center">{fmtNum(rekapULP.jumlahPelgn)}</td>
                        <td className="border-2 border-black p-2 text-center">{fmtNum(ct.target)}</td>
                        <td className="border-2 border-black p-2 text-center">{fmtNum(ct.real)}</td>
                        <td className="border-2 border-black p-2 text-center bg-[#fde047]">{fmtPct(ct.persen)}</td>
                        <td colSpan={2} className="border-2 border-black p-2 text-center">
                          {ct.capai100} dari {processedOfficers.length} Petugas Capai ≥100%
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            );
          })()}

        </div>
      </main>
    </div>
  );
