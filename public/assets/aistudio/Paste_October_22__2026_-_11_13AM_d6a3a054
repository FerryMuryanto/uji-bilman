                      <th>NO</th><th>KODE PETUGAS</th><th>NAMA PETUGAS</th><th>JML PELANGGAN</th><th>TARGET MODUL</th><th>REALISASI MODUL</th><th>PERSENTASE</th>
                    </tr>
