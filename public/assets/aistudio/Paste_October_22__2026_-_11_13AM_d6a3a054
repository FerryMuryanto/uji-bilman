            if (!feat) return null;

            const menuNo = 14 + featIndex;
            const ct = rekapULP.customTotals?.[feat.id] || { target: 0, real: 0, persen: 0, capai100: 0 };

            const handleExportCustomModuleExcel = () => {
              const html = `
                <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel">
                <head><meta charset="UTF-8"></head>
                <body>
                  <table border="1">
