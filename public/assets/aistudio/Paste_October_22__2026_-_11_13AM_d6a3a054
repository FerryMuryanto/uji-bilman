  const processedOfficers = useMemo(() => {
    const computed = officers.map((item) => {
      const p2dpReal = selectedPeriodView === "pagi" ? item.pagi.p2dp
        : selectedPeriodView === "siang" ? item.siang.p2dp : item.p2dpReal;
      const prevReal = selectedPeriodView === "pagi" ? item.pagi.prev
        : selectedPeriodView === "siang" ? item.siang.prev : item.prevReal;
      const korReal = selectedPeriodView === "pagi" ? item.pagi.kor
        : selectedPeriodView === "siang" ? item.siang.kor : item.korReal;

      const targetAll = settings.targetAllMode === "sum_komponen"
        ? (Number(item.p2dpTarget) + Number(item.prevTarget) + Number(item.korTarget))
        : Number(item.targetAll);

      const p2dpPersen = calcPct(p2dpReal, item.p2dpTarget);
      const prevPersen = calcPct(prevReal, item.prevTarget);
      const korPersen = calcPct(korReal, item.korTarget);

      const jumlahRealisasi = Number(p2dpReal) + Number(prevReal) + Number(korReal);

      let persenTotal = 0;
      if (settings.formulaMode === "proporsional") {
        persenTotal = calcPct(jumlahRealisasi, targetAll);
      } else {
        const w1 = Number(settings.bobotP2DP) / 100;
        const w2 = Number(settings.bobotPrev) / 100;
        const w3 = Number(settings.bobotKor) / 100;
        persenTotal = (p2dpPersen * w1) + (prevPersen * w2) + (korPersen * w3);
      }

      const deltaPagiKeSiang = (item.siang.p2dp + item.siang.prev + item.siang.kor) -
        (item.pagi.p2dp + item.pagi.prev + item.pagi.kor);
      const deltaSiangKeSore = (item.p2dpReal + item.prevReal + item.korReal) -
        (item.siang.p2dp + item.siang.prev + item.siang.kor);

      const customMetrics = {};
      let extraCustomTarget = 0;
      let extraCustomReal = 0;

      customFeatures.forEach((feat) => {
        const storedCustom = item.customData?.[feat.id];
        const defTgt = Number(feat.defaultTarget) > 0 ? Number(feat.defaultTarget) : 15;
        const cTarget = storedCustom?.target !== undefined ? Number(storedCustom.target) : defTgt;
        const ratio = item.p2dpTarget > 0 ? (p2dpReal / item.p2dpTarget) : 0.8;
        const detReal = p2dpReal === 0 ? 0 : Math.min(cTarget, Math.max(0, Math.round(cTarget * ratio)));
        const cReal = storedCustom?.real !== undefined ? Number(storedCustom.real) : detReal;
        const cPersen = calcPct(cReal, cTarget);

        customMetrics[feat.id] = {
          target: cTarget,
          real: cReal,
          persen: cPersen
        };

        if (feat.includeInTotalUlp) {
          extraCustomTarget += cTarget;
          extraCustomReal += cReal;
        }
      });

      const finalTargetAll = targetAll + extraCustomTarget;
      const finalJumlahRealisasi = jumlahRealisasi + extraCustomReal;
      const finalPersenTotal = settings.formulaMode === "proporsional"
        ? calcPct(finalJumlahRealisasi, finalTargetAll)
        : persenTotal;

      return {
        ...item,
        targetAll: finalTargetAll,
        activeP2dpReal: p2dpReal,
        activePrevReal: prevReal,
        activeKorReal: korReal,
        p2dpPersen,
        prevPersen,
        korPersen,
        jumlahRealisasi: finalJumlahRealisasi,
        persenTotal: finalPersenTotal,
        deltaPagiKeSiang,
        deltaSiangKeSore,
        customMetrics
      };
    });

    const sortedForRank = [...computed].sort((a, b) => {
      if (b.persenTotal !== a.persenTotal) return b.persenTotal - a.persenTotal;
      if (b.jumlahRealisasi !== a.jumlahRealisasi) return b.jumlahRealisasi - a.jumlahRealisasi;
      return a.no - b.no;
    });

    const rankMap = {};
    sortedForRank.forEach((o, i) => {
      rankMap[o.id] = i + 1;
    });

    return computed.map(o => ({
      ...o,
      ranking: rankMap[o.id]
    }));
  }, [officers, settings, selectedPeriodView, customFeatures]);

  const rekapULP = useMemo(() => {
    const totals = processedOfficers.reduce((acc, curr) => {
      acc.jumlahPelgn += Number(curr.jumlahPelgn) || 0;
      acc.targetAll += Number(curr.targetAll) || 0;
      acc.p2dpTarget += Number(curr.p2dpTarget) || 0;
      acc.p2dpReal += Number(curr.activeP2dpReal) || 0;
      acc.prevTarget += Number(curr.prevTarget) || 0;
      acc.prevReal += Number(curr.activePrevReal) || 0;
      acc.korTarget += Number(curr.korTarget) || 0;
      acc.korReal += Number(curr.activeKorReal) || 0;
      acc.jumlahRealisasi += Number(curr.jumlahRealisasi) || 0;

      acc.pagiTotal += (curr.pagi.p2dp + curr.pagi.prev + curr.pagi.kor);
      acc.siangTotal += (curr.siang.p2dp + curr.siang.prev + curr.siang.kor);
      acc.soreTotal += (curr.p2dpReal + curr.prevReal + curr.korReal);
      return acc;
    }, {
      jumlahPelgn: 0,
      targetAll: 0,
      p2dpTarget: 0,
      p2dpReal: 0,
      prevTarget: 0,
      prevReal: 0,
      korTarget: 0,
      korReal: 0,
      jumlahRealisasi: 0,
      pagiTotal: 0,
      siangTotal: 0,
      soreTotal: 0
    });

    const p2dpPersen = calcPct(totals.p2dpReal, totals.p2dpTarget);
    const prevPersen = calcPct(totals.prevReal, totals.prevTarget);
    const korPersen = calcPct(totals.korReal, totals.korTarget);

    let persenTotal = 0;
    if (settings.formulaMode === "proporsional") {
      persenTotal = calcPct(totals.jumlahRealisasi, totals.targetAll);
    } else {
      persenTotal =
        (p2dpPersen * (settings.bobotP2DP / 100)) +
        (prevPersen * (settings.bobotPrev / 100)) +
        (korPersen * (settings.bobotKor / 100));
    }

    const count100 = processedOfficers.filter(o => o.persenTotal >= 100).length;
    const countZero = processedOfficers.filter(o => o.jumlahRealisasi === 0).length;
    const countBelumTarget = processedOfficers.filter(o => o.persenTotal < 100).length;

    const customTotals = {};
    customFeatures.forEach((feat) => {
      const sumTgt = processedOfficers.reduce((acc, o) => acc + (o.customMetrics?.[feat.id]?.target || 0), 0);
      const sumReal = processedOfficers.reduce((acc, o) => acc + (o.customMetrics?.[feat.id]?.real || 0), 0);
      const pct = calcPct(sumReal, sumTgt);
      const capai100 = processedOfficers.filter(o => (o.customMetrics?.[feat.id]?.persen || 0) >= 100).length;
      customTotals[feat.id] = {
        target: sumTgt,
        real: sumReal,
        persen: pct,
        capai100
      };
    });

    return {
      ...totals,
      p2dpPersen,
      prevPersen,
      korPersen,
      persenTotal,
      count100,
      countZero,
      countBelumTarget,
      customTotals
    };
