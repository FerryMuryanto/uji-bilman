                    <div className="text-amber-400 font-bold mb-2">
                      // POLA 1 & 2: Tambah Field di State + Rumus Otomatis di processedOfficers
                    </div>
                    <pre>{`// 1. Tambahkan field baru pada generateInitialData() & State:
{
  id: 1,
  petugas: "AHMAD FAUZI",
  rampungTarget: 15,
  rampungReal: 12
}

// 2. Tambahkan rumus perhitungan otomatis di dalam useMemo processedOfficers:
const rampungPersen = calcPct(item.rampungReal, item.rampungTarget);
const jumlahRealisasi = p2dpReal + prevReal + korReal + item.rampungReal;

// 3. Tambahkan agregasi ke rekapULP (Total ULP Tegal Timur):
acc.rampungTarget += Number(curr.rampungTarget) || 0;
acc.rampungReal += Number(curr.rampungReal) || 0;
const rampungPersenULP = calcPct(totals.rampungReal, totals.rampungTarget);`}</pre>
