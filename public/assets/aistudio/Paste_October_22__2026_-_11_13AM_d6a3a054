                      // POLA 3 & 4: Daftarkan di MENU_ITEMS + Tabel Database SQLite/FastAPI
                    </div>
                    <pre>{`// 3. Daftarkan menu baru pada konstanta MENU_ITEMS:
const MENU_ITEMS = [
  ...existingMenus,
  { id: "mon_rampung", label: "Monitoring Rampung", icon: CheckCircle2 }
];

// 4. Render tampilan menu di dalam <main>:
{activeMenu === "mon_rampung" && (
  <TabelMonitoringBaru data={processedOfficers} rekap={rekapULP} />
)}

# 5. Jika menggunakan SQLite lokal (backend/main.py), tambahkan kolom:
ALTER TABLE master_petugas ADD COLUMN rampung_target INTEGER DEFAULT 0;
ALTER TABLE master_petugas ADD COLUMN rampung_real INTEGER DEFAULT 0;`}</pre>
