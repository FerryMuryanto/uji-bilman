const generateInitialData = (ulpId = "TEGAL_TIMUR") => {
  const ulpMeta = DAFTAR_ULP_UP3_TEGAL.find(u => u.id === ulpId) || DAFTAR_ULP_UP3_TEGAL[0];
  const ulpSeedOffset = DAFTAR_ULP_UP3_TEGAL.findIndex(u => u.id === ulpId) * 7;

  return INITIAL_OFFICERS_NAMES.map((name, idx) => {
    const seed = ((idx + ulpSeedOffset) * 17 + 13) % 100;
    const pelgn = 1150 + (((idx + ulpSeedOffset) * 29) % 450);
    const p2dpTarget = 25 + ((idx + ulpSeedOffset) % 3) * 5;
    const prevTarget = 20 + ((idx + ulpSeedOffset) % 2) * 5;
    const korTarget = 10 + ((idx + ulpSeedOffset) % 2) * 5;
    const targetAll = p2dpTarget + prevTarget + korTarget;

    let perfFactor = 0.85;
    if ((idx + ulpSeedOffset) % 9 === 0) perfFactor = 1.05;
    else if (idx === 41 || idx === 44) perfFactor = 0;
    else if ((idx + ulpSeedOffset) % 7 === 0) perfFactor = 0.42;
    else if ((idx + ulpSeedOffset) % 5 === 0) perfFactor = 0.68;
    else perfFactor = 0.78 + (seed / 450);

    const p2dpReal = perfFactor === 0 ? 0 : Math.min(p2dpTarget + 4, Math.max(0, Math.round(p2dpTarget * perfFactor)));
    const prevReal = perfFactor === 0 ? 0 : Math.min(prevTarget + 3, Math.max(0, Math.round(prevTarget * (perfFactor + 0.04))));
    const korReal = perfFactor === 0 ? 0 : Math.min(korTarget + 2, Math.max(0, Math.round(korTarget * (perfFactor - 0.03))));

    const p2dpPagi = Math.max(0, Math.round(p2dpReal * 0.55));
    const prevPagi = Math.max(0, Math.round(prevReal * 0.55));
    const korPagi = Math.max(0, Math.round(korReal * 0.55));

    const p2dpSiang = Math.max(p2dpPagi, Math.round(p2dpReal * 0.82));
    const prevSiang = Math.max(prevPagi, Math.round(prevReal * 0.82));
    const korSiang = Math.max(korPagi, Math.round(korReal * 0.82));

    return {
      id: idx + 1,
      no: idx + 1,
      kodePetugas: `${ulpMeta.kodePrefix}-${String(idx + 1).padStart(3, '0')}`,
      petugas: name,
      wilayah: `RBM ${ulpMeta.nama.replace('ULP ', '')} ${(idx % 6) + 1}`,
      jumlahPelgn: pelgn,
      targetAll: targetAll,
      p2dpTarget,
      p2dpReal,
      prevTarget,
      prevReal,
      korTarget,
      korReal,
      pagi: { p2dp: p2dpPagi, prev: prevPagi, kor: korPagi },
      siang: { p2dp: p2dpSiang, prev: prevSiang, kor: korSiang },
      sore: { p2dp: p2dpReal, prev: prevReal, kor: korReal }
    };
  });
};

