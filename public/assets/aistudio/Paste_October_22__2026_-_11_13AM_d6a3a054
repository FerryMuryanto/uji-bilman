  const parseRawTextToOfficers = (rawText) => {
    if (!rawText || !rawText.trim()) return [];
    const lines = rawText
      .split(/\r?\n/)
      .map(l => l.trim())
      .filter(Boolean);

    const parsed = [];
    lines.forEach((line) => {
      const delimiter = line.includes("\t") ? "\t" : line.includes(";") ? ";" : ",";
      const cols = line.split(delimiter).map(c => c.replace(/^"|"$/g, "").trim());
      const firstColUpper = (cols[0] || "").toUpperCase();
      const secondColUpper = (cols[1] || "").toUpperCase();
      if (
        firstColUpper === "NO" ||
        firstColUpper.includes("KODE") ||
        secondColUpper.includes("NAMA_PETUGAS") ||
        secondColUpper === "PETUGAS" ||
        firstColUpper.includes("TEMPLATE")
      ) {
        return;
      }

      let kode = "";
      let nama = "";
      let wilayah = "";
      let pelgn = 1200;
      let p2dpT = 25, p2dpR = 0, prevT = 20, prevR = 0, korT = 10, korR = 0;

      if (cols.length === 1) {
        nama = cols[0].toUpperCase();
      } else if (cols.length >= 2 && isNaN(Number(cols[0]))) {
        if (cols[0].toUpperCase().startsWith("BM-") || cols[0].length <= 10) {
          kode = cols[0].toUpperCase();
          nama = (cols[1] || "").toUpperCase();
          pelgn = Number(cols[2]) || 1200;
          p2dpT = Number(cols[3]) || 25;
          p2dpR = Number(cols[4]) || 0;
          prevT = Number(cols[5]) || 20;
          prevR = Number(cols[6]) || 0;
          korT = Number(cols[7]) || 10;
          korR = Number(cols[8]) || 0;
        } else {
          nama = cols[0].toUpperCase();
          pelgn = Number(cols[1]) || 1200;
          p2dpT = Number(cols[2]) || 25;
          p2dpR = Number(cols[3]) || 0;
          prevT = Number(cols[4]) || 20;
          prevR = Number(cols[5]) || 0;
          korT = Number(cols[6]) || 10;
          korR = Number(cols[7]) || 0;
        }
      } else {
        kode = (cols[1] || "").toUpperCase();
        nama = (cols[2] || cols[1] || "").toUpperCase();
        if (cols.length >= 11) {
          wilayah = cols[3];
          pelgn = Number(cols[4]) || 1200;
          p2dpT = Number(cols[5]) || 25;
          p2dpR = Number(cols[6]) || 0;
          prevT = Number(cols[7]) || 20;
          prevR = Number(cols[8]) || 0;
          korT = Number(cols[9]) || 10;
          korR = Number(cols[10]) || 0;
        } else {
          pelgn = Number(cols[3]) || 1200;
          p2dpT = Number(cols[4]) || 25;
          p2dpR = Number(cols[5]) || 0;
          prevT = Number(cols[6]) || 20;
          prevR = Number(cols[7]) || 0;
          korT = Number(cols[8]) || 10;
          korR = Number(cols[9]) || 0;
        }
      }

      if (!nama) return;
      const idx = parsed.length + 1;
      parsed.push({
        id: idx,
        no: idx,
        kodePetugas: kode || `${activeUlpMeta.kodePrefix}-${String(idx).padStart(3, "0")}`,
        petugas: nama,
        wilayah: wilayah || `RBM ${activeUlpMeta.nama.replace("ULP ", "")} ${((idx - 1) % 6) + 1}`,
        jumlahPelgn: pelgn,
        targetAll: p2dpT + prevT + korT,
        p2dpTarget: p2dpT,
        p2dpReal: p2dpR,
        prevTarget: prevT,
        prevReal: prevR,
        korTarget: korT,
        korReal: korR,
        pagi: { p2dp: Math.round(p2dpR * 0.55), prev: Math.round(prevR * 0.55), kor: Math.round(korR * 0.55) },
        siang: { p2dp: Math.round(p2dpR * 0.82), prev: Math.round(prevR * 0.82), kor: Math.round(korR * 0.82) },
        sore: { p2dp: p2dpR, prev: prevR, kor: korR }
      });
    });

