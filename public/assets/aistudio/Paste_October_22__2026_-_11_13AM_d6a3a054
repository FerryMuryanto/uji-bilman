                      <td>${ct.real}</td>
                      <td>${fmtPct(ct.persen)}</td>
                    </tr>
                  </table>
                </body></html>
              `;
              const blob = new Blob([html], { type: "application/vnd.ms-excel" });
              const url = URL.createObjectURL(blob);
              const a = document.createElement("a");
              a.href = url;
              a.download = `MODUL_${menuNo}_${feat.namaFitur.replace(/\s+/g, '_').toUpperCase()}_${activeUlpMeta.id}.xls`;
              a.click();
              URL.revokeObjectURL(url);
              showToast("Export Excel Modul Berhasil", `Laporan Excel untuk Menu ${menuNo} (${feat.namaFitur}) berhasil diunduh.`);
            };

            return (
              <div className="space-y-5">
                <div className="bg-gradient-to-r from-teal-900 via-emerald-900 to-slate-900 text-white p-6 rounded-2xl shadow-md flex flex-wrap items-center justify-between gap-4">
                  <div className="space-y-1">
                    <div className="flex flex-wrap items-center gap-2">
                      <span className="px-2.5 py-0.5 rounded-md bg-amber-400 text-slate-950 font-black text-xs">
                        MENU {menuNo} (MODUL BARU AKTIF)
                      </span>
                      <span className="px-2.5 py-0.5 rounded-md bg-white/15 text-teal-200 font-mono text-xs">
                        ID: {feat.id} • Field: {feat.fieldBaru}
                      </span>
                      <span className="px-2.5 py-0.5 rounded-md bg-emerald-500/30 text-emerald-200 font-bold text-xs">
