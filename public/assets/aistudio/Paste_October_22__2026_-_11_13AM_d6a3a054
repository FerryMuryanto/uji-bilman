const calcPct = (real, target) => {
  if (!target || target <= 0) return 0;
  return (Number(real) / Number(target)) * 100;
};

const fmtPct = (val) => {
  if (val === null || val === undefined || isNaN(val)) return "0,0%";
  return `${val.toFixed(1).replace('.', ',')}%`;
};

const fmtNum = (val) => {
  if (val === null || val === undefined || isNaN(val)) return "0";
  return Number(val).toLocaleString('id-ID');
};

const getPerfCellStyle = (pct, real, thresholds) => {
  if (Number(real) === 0 || pct <= 0) {
    return {
      bg: "bg-[#ef4444] text-white font-bold",
      hexBg: "#ef4444",
      hexText: "#ffffff",
      label: "Sangat Rendah / Nol (0%)"
    };
  }
  if (pct >= thresholds.hijauTua) {
    return {
      bg: "bg-[#16a34a] text-white font-bold",
      hexBg: "#16a34a",
      hexText: "#ffffff",
      label: "Tercapai / Tinggi (≥100%)"
    };
  }
  if (pct >= thresholds.hijauMuda) {
    return {
      bg: "bg-[#86efac] text-slate-900 font-semibold",
      hexBg: "#86efac",
      hexText: "#0f172a",
      label: "Baik (80% - 99%)"
    };
  }
  if (pct >= thresholds.kuning) {
    return {
      bg: "bg-[#fde047] text-slate-900 font-semibold",
      hexBg: "#fde047",
      hexText: "#0f172a",
      label: "Sedang (60% - 79%)"
    };
  }
  if (pct >= thresholds.oranye) {
    return {
      bg: "bg-[#fb923c] text-slate-950 font-semibold",
      hexBg: "#fb923c",
      hexText: "#090d16",
      label: "Rendah (40% - 59%)"
    };
  }
  return {
    bg: "bg-[#ef4444] text-white font-bold",
    hexBg: "#ef4444",
    hexText: "#ffffff",
    label: "Sangat Rendah (<40%)"
  };
};

